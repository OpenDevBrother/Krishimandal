# =============================================================================
# KrishiMandal Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Lines marked [REQUIRED] must be set for the app to function.
# Lines marked [FALLBACK] are only used by the EC2 backend as a fallback.
# Lines marked [OPTIONAL] have sensible defaults or are only needed in production.

# ─── Mode ────────────────────────────────────────────────────────────────────
# When true, farm/price/scheme data is mocked locally (SQLite).
# LLM, RAG, voice, and WhatsApp still call real APIs.
USE_DUMMY_DATA=true
APP_ENV=development          # development | production
APP_PORT=8000
LOG_LEVEL=INFO

# ─── AWS [REQUIRED for serverless / production] ─────────────────────────────
# Used by Lambda functions, S3, DynamoDB, Bedrock, EventBridge.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ─── Amazon Bedrock [REQUIRED — primary AI backend] ─────────────────────────
# Nova Pro for LLM responses and Titan for embeddings.
# Powers the multi-agent orchestrator, RAG pipeline, and all AI features.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ─── Amazon S3 [REQUIRED for RAG] ───────────────────────────────────────────
# Knowledge base bucket — stores PDFs and JSON chunks for RAG pipeline.
# Documents are embedded with Bedrock Titan and searched via in-memory cosine similarity.
BEDROCK_KB_S3_BUCKET=krishimandal-knowledge-content

# ─── Sarvam AI — Voice [REQUIRED for voice assistant] ───────────────────────
# Saaras v3 (STT) and Bulbul v3 (TTS) for 22 Indian languages.
# Get your key at https://dashboard.sarvam.ai
SARVAM_AI_API_KEY=your_sarvam_api_key

# ─── Twilio — WhatsApp [OPTIONAL] ───────────────────────────────────────────
# Real-time alerts, daily digest, and AI-triggered WhatsApp messages.
# For sandbox: use +14155238886 as the WhatsApp number.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# ─── Groq LLM [FALLBACK — EC2 backend only] ─────────────────────────────────
# Used by the EC2 FastAPI backend as a fallback LLM when Bedrock is unavailable.
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL_ID=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.3

# ─── Google Gemini — Embeddings [FALLBACK — EC2 backend only] ───────────────
# Fallback embeddings for the EC2 RAG pipeline (used when Bedrock Titan is unavailable).
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ─── Pinecone — Vector DB [FALLBACK — EC2 backend only] ─────────────────────
# Fallback vector store for EC2 RAG pipeline (used when S3 + in-memory search is unavailable).
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=krishimandal-knowledge
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws
PINECONE_METRIC=cosine
PINECONE_DIMENSION=768

# ─── OpenWeatherMap [OPTIONAL] ──────────────────────────────────────────────
# Weather data for digital twin. Falls back to dummy data if not set.
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# ─── e-NAM Mandi Prices [OPTIONAL] ──────────────────────────────────────────
# Public API — no key needed; base URL for reference.
ENAM_API_BASE_URL=https://enam.gov.in/web/dashboard/trade-data
