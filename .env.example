# =============================================================================
# KrishiMandal Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.

# --- AWS Configuration (not used when USE_DUMMY_DATA=true) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- Amazon Bedrock (not used when USE_DUMMY_DATA=true) ---
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250514
BEDROCK_EMBEDDING_MODEL_ID=amazon.nova-embed-multimodal-v1:0
BEDROCK_GUARDRAIL_ID=your_guardrail_id
BEDROCK_GUARDRAIL_VERSION=DRAFT

# --- Amazon Bedrock Knowledge Base (RAG - not used when USE_DUMMY_DATA=true) ---
BEDROCK_KNOWLEDGE_BASE_ID=your_knowledge_base_id
BEDROCK_KB_S3_BUCKET=krishimandal-knowledge-content




# --- Sarvam AI (Voice / STT / TTS) ---
SARVAM_AI_API_KEY=your_sarvam_ai_api_key
SARVAM_AI_BASE_URL=https://api.sarvam.ai/v1

# --- Twilio (Voice / SMS / WhatsApp) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1800XXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+919XXXXXXXXX

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/krishimandal
REDIS_URL=redis://localhost:6379/0

# --- External APIs ---
# e-NAM (National Agriculture Market) - Public Mandi Prices
ENAM_API_BASE_URL=https://enam.gov.in/web/dashboard/trade-data
# AgriStack (India Digital Agriculture Mission)
AGRISTACK_API_KEY=your_agristack_api_key
AGRISTACK_BASE_URL=https://api.agristack.gov.in/v1
# IMD Weather API
IMD_API_KEY=your_imd_api_key
# OpenWeatherMap (fallback for weather)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
# Sentinel Hub (Satellite Imagery)
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret

# --- Application Settings ---
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Dummy data mode — when true, domain data (farms, prices, schemes) is mocked
# but LLM (Groq), Embeddings (Gemini), and RAG (Pinecone) still use real APIs
USE_DUMMY_DATA=true
